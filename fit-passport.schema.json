{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omniroot/fit-passport-v0.1.schema.json",
  "title": "OmniRoot private Fit Passport (illustrative)",
  "description": "Draft technical representation only; do not deploy as a production privacy solution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fit_profile_id",
    "owner_id",
    "unit",
    "measurement_method",
    "measurements"
  ],
  "properties": {
    "fit_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "unit": {
      "type": "string",
      "enum": [
        "cm",
        "in"
      ]
    },
    "measurement_method": {
      "type": "string",
      "enum": [
        "self_reported",
        "professional",
        "scan_import"
      ]
    },
    "measurement_date": {
      "type": "string",
      "format": "date"
    },
    "measurements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{2,79}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/measurement"
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ease": {
          "type": "string",
          "enum": [
            "relaxed",
            "regular",
            "tailored",
            "custom"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "adaptive_preferences_private": {
      "type": "string",
      "maxLength": 2000
    },
    "demo_only": {
      "type": "boolean"
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "definition_id"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "unit": {
          "type": "string",
          "enum": [
            "cm",
            "in"
          ]
        },
        "definition_id": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
